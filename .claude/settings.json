{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b sesion/*)",
      "Bash(git switch:*)",
      "Bash(python scripts/check_ids.py:*)",
      "Bash(python3 scripts/check_ids.py:*)",
      "Bash(git push -u origin sesion/*)"
    ],
    "deny": [
      "Read(archivo/**)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Edit(archivo/**)",
      "Write(archivo/**)"
    ]
  }
}